---
source: tests/snapshots.rs
expression: "split(input, true).expect(\"parse\")"
---
[
  [
    {
      "command": "grep \"$pattern\" \"$f\" > \"out/$f\"",
      "name": "grep",
      "args": [
        "\"$pattern\"",
        "\"$f\""
      ],
      "dynamic_args": [
        0,
        1
      ],
      "redirects": [
        {
          "op": ">",
          "kind": "file",
          "target": "\"out/$f\""
        }
      ],
      "in_loop": true,
      "variables": [
        "pattern",
        "f"
      ]
    }
  ]
]
